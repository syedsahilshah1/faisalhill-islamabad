<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route every request through the Laravel front controller. Because all
    # traffic is rewritten, application source (backend/, frontend/, .env,
    # .git, artisan, composer.json) is never served directly.
    RewriteCond %{REQUEST_URI} !^/index\.php$
    RewriteRule ^ index.php [L]
</IfModule>

# Defense in depth: deny sensitive files even if mod_rewrite is unavailable.
<FilesMatch "\.(env|log|lock)$">
    Require all denied
</FilesMatch>
